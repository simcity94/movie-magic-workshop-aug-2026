

            <section id="create-page">
                <div class="createSection">
                    <div class="info">
                        <h2>"Today, I consider myself the luckiest man on the face of the earth." -The Pride of the Yankees, 1942</h2>
                    </div>

                    <form method="post" class="createForm">
                        <h2>Add Movie</h2>
                        <ul class="noBullet">
                            <li>
                                <label for="title">Title:</label>
                                <input type="text" class="inputFields" id="title" name="title" value="{{movie.title}}" />
                                {{> multipleErrors errors=errors.title }}
                            </li>
                            <li>
                                {{> selectCategory }}
                                {{> multipleErrors errors=errors.category }}
                            </li>
                            <li>
                                <label for="genre">Genre:</label>
                                <input type="text" class="inputFields" id="genre" name="genre" value="{{movie.genre}}" />
                                {{> multipleErrors errors=errors.genre }}
                            </li>
                            <li>
                                <label for="director">Director:</label>
                                <input type="text" class="inputFields" id="director" name="director" value="{{movie.director}}" />
                                {{> multipleErrors errors=errors.director }}
                            </li>
                            <li>
                                <label for="date">Year:</label>
                                <input type="number" class="inputFields" id="year" name="year" value="{{movie.year}}" />
                                {{> multipleErrors errors=errors.year }}
                            </li>
                            <li>
                                <label for="image">Movie Poster:</label>
                                <input type="text" class="inputFields" id="image" name="imageUrl" value="{{movie.imageUrl}}" />
                                {{> multipleErrors errors=errors.imageUrl }}
                            </li>
                            <li>
                                <label for="image">Rating:</label>
                                <input type="text" class="inputFields" id="rating" name="rating" value="{{movie.rating}}" />
                                {{> multipleErrors errors=errors.rating }}
                            </li>
                            <li>
                                <label for="description">Description:</label>
                                <textarea id="description" class="inputFields" name="description"></textarea>]
                                {{> multipleErrors errors=errors.description }}
                            </li>
                         
                            <li id="center-btn">
                                <button id="create-btn">Add Movie</button>
                            </li>

                            
                        </ul>
                    </form>
                    

                </div>


            </section>